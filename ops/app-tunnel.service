# Publishes the frontend NodePort (inside minikube) on the VM's own network,
# so the app is reachable from the host machine at http://192.168.56.10:4200
# Install:  sudo cp ops/app-tunnel.service /etc/systemd/system/ && sudo systemctl enable --now app-tunnel
[Unit]
Description=Expose minikube frontend NodePort on port 4200
After=network-online.target docker.service

[Service]
ExecStart=/usr/bin/socat TCP-LISTEN:4200,fork,reuseaddr TCP:192.168.49.2:30080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
